{
  "$schema": "./registry.schema.json",
  "version": "2.0.0",
  "description": "RSR Script Registry - Developer-friendly organization",
  "categories": {
    "security": {
      "name": "Security",
      "description": "Security auditing, hardening, and compliance scripts",
      "subcategories": ["audit", "hardening", "certificates", "ssh"]
    },
    "system": {
      "name": "System",
      "description": "System health, updates, cleanup, and information scripts",
      "subcategories": ["health", "updates", "cleanup", "info"]
    },
    "users": {
      "name": "Users",
      "description": "User and account management scripts",
      "subcategories": ["management", "setup"]
    },
    "network": {
      "name": "Network",
      "description": "Network diagnostics and DNS management scripts",
      "subcategories": ["diagnostics", "dns"]
    },
    "containers": {
      "name": "Containers",
      "description": "Container orchestration and management scripts",
      "subcategories": ["docker", "compose"]
    },
    "backup": {
      "name": "Backup",
      "description": "Database, configuration, and git backup scripts",
      "subcategories": ["database", "config", "git"]
    }
  },
  "scripts": [
    {
      "id": "security-audit",
      "name": "Security Audit",
      "description": "Comprehensive security audit: ports, logins, SUID files, permissions",
      "category": "security",
      "subcategory": "audit",
      "path": "security/audit/security-audit.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+"],
      "sudo": "optional",
      "tags": ["security", "audit", "compliance", "hardening"]
    },
    {
      "id": "user-audit",
      "name": "User Audit",
      "description": "Audit user accounts, sudo access, and login history",
      "category": "security",
      "subcategory": "audit",
      "path": "security/audit/user-audit.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+"],
      "sudo": "optional",
      "tags": ["users", "audit", "security", "accounts"]
    },
    {
      "id": "ssh-hardening",
      "name": "SSH Hardening",
      "description": "Harden SSH: disable root, enforce keys, configure fail2ban",
      "category": "security",
      "subcategory": "hardening",
      "path": "security/hardening/ssh-hardening.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+", "sshd"],
      "sudo": "required",
      "tags": ["ssh", "security", "hardening"]
    },
    {
      "id": "firewall-setup",
      "name": "Firewall Setup",
      "description": "Configure firewall with ufw/iptables/firewalld presets",
      "category": "security",
      "subcategory": "hardening",
      "path": "security/hardening/firewall-setup.sh",
      "version": "1.0.0",
      "platforms": ["linux"],
      "requires": ["bash 4.0+", "ufw|iptables|firewalld"],
      "sudo": "required",
      "tags": ["firewall", "security", "network"]
    },
    {
      "id": "ssl-checker",
      "name": "SSL Certificate Checker",
      "description": "Check SSL certificate expiry, chain validity, and ciphers",
      "category": "security",
      "subcategory": "certificates",
      "path": "security/certificates/ssl-checker.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+", "openssl"],
      "sudo": "none",
      "tags": ["ssl", "tls", "certificates", "security"]
    },
    {
      "id": "ssh-server",
      "name": "SSH Server Management",
      "description": "Complete SSH server management: install, configure, monitor",
      "category": "security",
      "subcategory": "ssh",
      "path": "security/ssh/ssh-server.sh",
      "powershell": "security/ssh/ssh-server.ps1",
      "version": "1.0.0",
      "platforms": ["linux", "macos", "windows"],
      "requires": ["bash 4.0+|PowerShell 5.1+"],
      "sudo": "required",
      "tags": ["ssh", "server", "management"]
    },
    {
      "id": "system-health",
      "name": "System Health Check",
      "description": "Check system health: CPU, memory, disk, network status",
      "category": "system",
      "subcategory": "health",
      "path": "system/health/system-health-check.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+"],
      "sudo": "none",
      "tags": ["health", "monitoring", "system", "diagnostics"]
    },
    {
      "id": "system-update",
      "name": "System Update",
      "description": "Update system packages, security patches, and kernel",
      "category": "system",
      "subcategory": "updates",
      "path": "system/updates/system-update.sh",
      "version": "1.0.0",
      "platforms": ["linux"],
      "requires": ["bash 4.0+", "apt|yum|dnf|pacman"],
      "sudo": "required",
      "tags": ["update", "packages", "security", "maintenance"]
    },
    {
      "id": "disk-cleanup",
      "name": "Disk Cleanup",
      "description": "Clean temp files, old logs, package cache, and old kernels",
      "category": "system",
      "subcategory": "cleanup",
      "path": "system/cleanup/disk-cleanup.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+"],
      "sudo": "optional",
      "tags": ["cleanup", "disk", "maintenance", "storage"]
    },
    {
      "id": "detect-distro",
      "name": "Detect Distribution",
      "description": "Detect Linux distribution, package manager, and init system",
      "category": "system",
      "subcategory": "info",
      "path": "system/info/detect-distro.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+"],
      "sudo": "none",
      "tags": ["distro", "detection", "system", "info"]
    },
    {
      "id": "user-management",
      "name": "User Management",
      "description": "Comprehensive user management: create, delete, passwords, groups",
      "category": "users",
      "subcategory": "management",
      "path": "users/management/user-management.sh",
      "powershell": "users/management/user-management.ps1",
      "version": "1.0.0",
      "platforms": ["linux", "macos", "windows"],
      "requires": ["bash 4.0+|PowerShell 5.1+"],
      "sudo": "required",
      "tags": ["users", "accounts", "passwords", "groups"]
    },
    {
      "id": "server-setup",
      "name": "Server Setup",
      "description": "Initial server setup: users, SSH hardening, firewall, tools",
      "category": "users",
      "subcategory": "setup",
      "path": "users/setup/server-setup.sh",
      "version": "1.0.0",
      "platforms": ["linux"],
      "requires": ["bash 4.0+"],
      "sudo": "required",
      "tags": ["setup", "server", "initialization"]
    },
    {
      "id": "network-diagnostics",
      "name": "Network Diagnostics",
      "description": "Diagnose network: connectivity, DNS, latency, port checks",
      "category": "network",
      "subcategory": "diagnostics",
      "path": "network/diagnostics/network-diagnostics.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+"],
      "sudo": "none",
      "tags": ["network", "diagnostics", "dns", "connectivity"]
    },
    {
      "id": "dns-sync",
      "name": "DNS Zone Sync",
      "description": "Sync DNS zones from git repository",
      "category": "network",
      "subcategory": "dns",
      "path": "network/dns/dns-sync.sh",
      "version": "1.0.0",
      "platforms": ["linux"],
      "requires": ["bash 4.0+", "git"],
      "sudo": "optional",
      "tags": ["dns", "sync", "gitops"]
    },
    {
      "id": "docker-management",
      "name": "Docker Management",
      "description": "Docker installation, container management, and cleanup",
      "category": "containers",
      "subcategory": "docker",
      "path": "containers/docker/docker-management.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+"],
      "sudo": "optional",
      "tags": ["docker", "containers", "management"]
    },
    {
      "id": "database-backup",
      "name": "Database Backup",
      "description": "Backup MySQL, PostgreSQL, MongoDB databases",
      "category": "backup",
      "subcategory": "database",
      "path": "backup/database/database-backup.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+"],
      "sudo": "optional",
      "tags": ["backup", "database", "mysql", "postgresql"]
    },
    {
      "id": "config-backup",
      "name": "Config Backup",
      "description": "Backup system and application configuration files",
      "category": "backup",
      "subcategory": "config",
      "path": "backup/config/config-backup.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+"],
      "sudo": "optional",
      "tags": ["backup", "config", "system"]
    },
    {
      "id": "git-auto-sync",
      "name": "Git Auto Sync",
      "description": "Production-grade git repository auto-sync daemon",
      "category": "backup",
      "subcategory": "git",
      "path": "backup/git/git-auto-sync.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+", "git"],
      "sudo": "optional",
      "tags": ["git", "sync", "backup", "automation"]
    }
  ]
}

