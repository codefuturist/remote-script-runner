      "platforms": {
        "linux": ["ubuntu", "debian", "rhel", "rocky", "almalinux", "fedora", "arch"],
        "macos": "full-support",
        "windows": {
          "support": "full-support",
          "versions": ["Windows 10", "Windows 11", "Server 2019", "Server 2022", "Server 2025"],
          "requires": ["PowerShell 5.1+"],
          "notes": "Supports local and domain users via PowerShell"
        }
      },
      "isNew": true
