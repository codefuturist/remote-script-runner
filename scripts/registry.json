      "category": "security",
      "subcategory": "audit",
      "path": "scripts/security/audit/security-audit.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+"],
      "sudo": "optional",
      "tags": ["security", "audit", "compliance", "hardening"]
    },
    {
      "id": "user-audit",
      "name": "User Audit",
      "command": "users",
      "aliases": ["users", "user-audit"],
      "description": "Audit user accounts, sudo access, and login history",
      "example": "rsr users",
