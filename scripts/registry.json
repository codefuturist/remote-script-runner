{
  "$schema": "./registry.schema.json",
  "version": "2.0.0",
  "description": "RSR Script Registry - Developer-friendly organization",
  "categories": {
    "security": {
      "name": "Security",
      "description": "Security auditing, hardening, and compliance scripts",
      "subcategories": ["audit", "hardening", "certificates", "ssh"]
    },
    "system": {
      "name": "System",
      "description": "System health, updates, cleanup, packages, and information scripts",
      "subcategories": ["health", "updates", "cleanup", "info", "packages"]
    },
    "users": {
      "name": "Users",
      "description": "User and account management scripts",
      "subcategories": ["management", "setup"]
    },
    "network": {
      "name": "Network",
      "description": "Network diagnostics and DNS management scripts",
      "subcategories": ["diagnostics", "dns"]
    },
    "containers": {
      "name": "Containers",
      "description": "Container orchestration and management scripts",
      "subcategories": ["docker", "compose"]
    },
    "backup": {
      "name": "Backup",
      "description": "Database, configuration, git, and file backup scripts",
      "subcategories": ["database", "config", "git", "tools"]
    }
  },
  "scripts": [
    {
      "id": "security-audit",
      "name": "Security Audit",
      "command": "audit",
      "aliases": ["audit", "security-audit"],
      "description": "Comprehensive security audit: ports, logins, SUID files, permissions",
      "example": "rsr audit",
      "category": "security",
      "subcategory": "audit",
      "path": "scripts/security/audit/security-audit.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+"],
      "sudo": "optional",
      "tags": ["security", "audit", "compliance", "hardening"]
    },
    {
      "id": "user-audit",
      "name": "User Audit",
      "command": "users",
      "aliases": ["users", "user-audit"],
      "description": "Audit user accounts, sudo access, and login history",
      "example": "rsr users",
      "category": "security",
      "subcategory": "audit",
      "path": "scripts/security/audit/user-audit.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+"],
      "sudo": "optional",
      "tags": ["users", "audit", "security", "accounts"]
    },
    {
      "id": "ssh-hardening",
      "name": "SSH Hardening",
      "command": "ssh-harden",
      "aliases": ["ssh-harden", "ssh-hardening"],
      "description": "Harden SSH: disable root, enforce keys, configure fail2ban",
      "example": "rsr ssh-harden",
      "category": "security",
      "subcategory": "hardening",
      "path": "scripts/security/hardening/ssh-hardening.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+", "sshd"],
      "sudo": "required",
      "tags": ["ssh", "security", "hardening"]
    },
    {
      "id": "firewall-setup",
      "name": "Firewall Setup",
      "command": "firewall",
      "aliases": ["firewall", "firewall-setup"],
      "description": "Configure firewall with ufw/iptables/firewalld presets",
      "example": "rsr firewall",
      "category": "security",
      "subcategory": "hardening",
      "path": "scripts/security/hardening/firewall-setup.sh",
      "version": "1.0.0",
      "platforms": ["linux"],
      "requires": ["bash 4.0+", "ufw|iptables|firewalld"],
      "sudo": "required",
      "tags": ["firewall", "security", "network"]
    },
    {
      "id": "ssl-checker",
      "name": "SSL Certificate Checker",
      "command": "ssl",
      "aliases": ["ssl", "ssl-checker", "ssl-check"],
      "description": "Check SSL certificate expiry, chain validity, and ciphers",
      "example": "rsr ssl example.com",
      "category": "security",
      "subcategory": "certificates",
      "path": "scripts/security/certificates/ssl-checker.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+", "openssl"],
      "sudo": "none",
      "tags": ["ssl", "tls", "certificates", "security"]
    },
    {
      "id": "ssh-server",
      "name": "SSH Server Management",
      "command": "ssh-server",
      "aliases": ["ssh-server"],
      "description": "Complete SSH server management: install, configure, monitor",
      "example": "rsr ssh-server status",
      "category": "security",
      "subcategory": "ssh",
      "path": "scripts/security/ssh/ssh-server.sh",
      "powershell": "security/ssh/ssh-server.ps1",
      "version": "1.0.0",
      "platforms": ["linux", "macos", "windows"],
      "requires": ["bash 4.0+|PowerShell 5.1+"],
      "sudo": "required",
      "tags": ["ssh", "server", "management"]
    },
    {
      "id": "ssh-keys",
      "name": "SSH Key Management",
      "command": "ssh-keys",
      "aliases": ["ssh-keys"],
      "description": "Generate, distribute, and manage SSH keys across hosts",
      "example": "rsr ssh-keys generate",
      "category": "security",
      "subcategory": "ssh",
      "path": "scripts/security/ssh/ssh-keys.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos", "freebsd"],
      "requires": ["bash 4.0+", "ssh", "ssh-keygen"],
      "sudo": "none",
      "tags": ["ssh", "keys", "authentication", "distribution", "security"]
    },
    {
      "id": "ssh-config",
      "name": "SSH Client Configuration",
      "command": "ssh-config",
      "aliases": ["ssh-config"],
      "description": "Manage SSH client configuration, hosts, tunnels, and best practices",
      "example": "rsr ssh-config init",
      "category": "security",
      "subcategory": "ssh",
      "path": "scripts/security/ssh/ssh-config.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos", "freebsd"],
      "requires": ["bash 4.0+", "ssh", "ssh-keygen"],
      "sudo": "none",
      "tags": ["ssh", "client", "config", "tunnels", "hosts", "configuration"]
    },
    {
      "id": "system-health",
      "name": "System Health Check",
      "command": "health",
      "aliases": ["health", "health-check", "system-health-check"],
      "description": "Check system health: CPU, memory, disk, network status",
      "example": "rsr health -a",
      "category": "system",
      "subcategory": "health",
      "path": "scripts/system/health/system-health-check.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+"],
      "sudo": "none",
      "tags": ["health", "monitoring", "system", "diagnostics"]
    },
    {
      "id": "system-update",
      "name": "System Update",
      "command": "update",
      "aliases": ["update", "system-update"],
      "description": "Update system packages, security patches, and kernel",
      "example": "rsr update",
      "category": "system",
      "subcategory": "updates",
      "path": "scripts/system/updates/system-update.sh",
      "version": "1.0.0",
      "platforms": ["linux"],
      "requires": ["bash 4.0+", "apt|yum|dnf|pacman"],
      "sudo": "required",
      "tags": ["update", "packages", "security", "maintenance"]
    },
    {
      "id": "disk-cleanup",
      "name": "Disk Cleanup",
      "command": "cleanup",
      "aliases": ["cleanup", "disk-cleanup"],
      "description": "Clean temp files, old logs, package cache, and old kernels",
      "example": "rsr cleanup --dry-run",
      "category": "system",
      "subcategory": "cleanup",
      "path": "scripts/system/cleanup/disk-cleanup.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+"],
      "sudo": "optional",
      "tags": ["cleanup", "disk", "maintenance", "storage"]
    },
    {
      "id": "detect-distro",
      "name": "Detect Distribution",
      "command": "detect-distro",
      "aliases": ["detect-distro"],
      "description": "Detect Linux distribution, package manager, and init system",
      "example": "rsr detect-distro",
      "category": "system",
      "subcategory": "info",
      "path": "scripts/system/info/detect-distro.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+"],
      "sudo": "none",
      "tags": ["distro", "detection", "system", "info"]
    },
    {
      "id": "user-management",
      "name": "User Management",
      "command": "user-mgmt",
      "aliases": ["user-mgmt", "user-management"],
      "description": "Comprehensive user management: create, delete, passwords, groups",
      "example": "rsr user-mgmt create john",
      "category": "users",
      "subcategory": "management",
      "path": "scripts/users/management/user-management.sh",
      "powershell": "users/management/user-management.ps1",
      "version": "1.0.0",
      "platforms": ["linux", "macos", "windows"],
      "requires": ["bash 4.0+|PowerShell 5.1+"],
      "sudo": "required",
      "tags": ["users", "accounts", "passwords", "groups"]
    },
    {
      "id": "server-setup",
      "name": "Server Setup",
      "command": "setup",
      "aliases": ["setup", "server-setup"],
      "description": "Initial server setup: users, SSH hardening, firewall, tools",
      "example": "rsr setup -d -u admin",
      "category": "users",
      "subcategory": "setup",
      "path": "scripts/users/setup/server-setup.sh",
      "version": "1.0.0",
      "platforms": ["linux"],
      "requires": ["bash 4.0+"],
      "sudo": "required",
      "tags": ["setup", "server", "initialization"]
    },
    {
      "id": "network-diagnostics",
      "name": "Network Diagnostics",
      "command": "netdiag",
      "aliases": ["netdiag", "network-diagnostics"],
      "description": "Diagnose network: connectivity, DNS, latency, port checks",
      "example": "rsr netdiag",
      "category": "network",
      "subcategory": "diagnostics",
      "path": "scripts/network/diagnostics/network-diagnostics.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+"],
      "sudo": "none",
      "tags": ["network", "diagnostics", "dns", "connectivity"]
    },
    {
      "id": "dns-sync",
      "name": "DNS Zone Sync",
      "command": "dns-sync",
      "aliases": ["dns-sync"],
      "description": "Sync DNS zones from git repository",
      "example": "rsr dns-sync",
      "category": "network",
      "subcategory": "dns",
      "path": "scripts/network/dns/dns-sync.sh",
      "version": "1.0.0",
      "platforms": ["linux"],
      "requires": ["bash 4.0+", "git"],
      "sudo": "optional",
      "tags": ["dns", "sync", "gitops"]
    },
    {
      "id": "docker-management",
      "name": "Docker Management",
      "command": "docker",
      "aliases": ["docker", "docker-management"],
      "description": "Docker installation, container management, and cleanup",
      "example": "rsr docker status",
      "category": "containers",
      "subcategory": "docker",
      "path": "scripts/containers/docker/docker-management.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+"],
      "sudo": "optional",
      "tags": ["docker", "containers", "management"]
    },
    {
      "id": "database-backup",
      "name": "Database Backup",
      "command": "db-backup",
      "aliases": ["db-backup", "database-backup"],
      "description": "Backup MySQL, PostgreSQL, MongoDB databases",
      "example": "rsr db-backup",
      "category": "backup",
      "subcategory": "database",
      "path": "scripts/backup/database/database-backup.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+"],
      "sudo": "optional",
      "tags": ["backup", "database", "mysql", "postgresql"]
    },
    {
      "id": "config-backup",
      "name": "Config Backup",
      "command": "backup",
      "aliases": ["backup", "config-backup"],
      "description": "Backup system and application configuration files",
      "example": "rsr backup",
      "category": "backup",
      "subcategory": "config",
      "path": "scripts/backup/config/config-backup.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+"],
      "sudo": "optional",
      "tags": ["backup", "config", "system"]
    },
    {
      "id": "git-auto-sync",
      "name": "Git Auto Sync",
      "command": "git-sync",
      "aliases": ["git-sync", "git-auto-sync"],
      "description": "Production-grade git repository auto-sync daemon",
      "example": "rsr git-sync start",
      "category": "backup",
      "subcategory": "git",
      "path": "scripts/backup/git/git-auto-sync.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+", "git"],
      "sudo": "optional",
      "tags": ["git", "sync", "backup", "automation"]
    },
    {
      "id": "install-packages",
      "name": "Install Packages",
      "command": "install-pkgs",
      "aliases": ["install-pkgs", "install-packages"],
      "description": "Install packages from predefined profiles with cross-platform support",
      "example": "rsr install-pkgs web-server",
      "category": "system",
      "subcategory": "packages",
      "path": "scripts/system/packages/install-packages.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+"],
      "sudo": "optional",
      "tags": ["packages", "dependencies", "installation", "profiles"]
    },
    {
      "id": "backup-unified",
      "name": "Unified Backup",
      "command": "backup",
      "aliases": ["backup", "backup-unified", "bkp"],
      "description": "Unified backup system supporting rsync, rclone, restic, borg, kopia, Time Machine",
      "example": "rsr backup run --source /home --dest /backup --tool restic",
      "category": "backup",
      "subcategory": "tools",
      "path": "scripts/backup/tools/backup-unified.sh",
      "powershell": "backup/tools/windows-backup.ps1",
      "version": "1.0.0",
      "platforms": ["linux", "macos", "windows"],
      "requires": ["bash 4.0+|PowerShell 5.1+"],
      "sudo": "optional",
      "tags": ["backup", "rsync", "rclone", "restic", "borg", "kopia", "deduplication", "encryption"]
    },
    {
      "id": "rsync-backup",
      "name": "Rsync Backup",
      "command": "rsync-backup",
      "aliases": ["rsync-backup", "rsync-bkp"],
      "description": "Fast incremental backup using rsync with hard links support",
      "example": "rsr rsync-backup /home /backup/home",
      "category": "backup",
      "subcategory": "tools",
      "path": "scripts/backup/tools/rsync-backup.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+", "rsync"],
      "sudo": "optional",
      "tags": ["backup", "rsync", "incremental", "sync"]
    },
    {
      "id": "rclone-backup",
      "name": "Rclone Backup",
      "command": "rclone-backup",
      "aliases": ["rclone-backup", "cloud-backup"],
      "description": "Cloud backup using rclone (40+ cloud providers)",
      "example": "rsr rclone-backup sync /home s3:mybucket/backup",
      "category": "backup",
      "subcategory": "tools",
      "path": "scripts/backup/tools/rclone-backup.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos", "windows"],
      "requires": ["bash 4.0+", "rclone"],
      "sudo": "none",
      "tags": ["backup", "rclone", "cloud", "s3", "gcs", "azure", "dropbox"]
    },
    {
      "id": "restic-backup",
      "name": "Restic Backup",
      "command": "restic-backup",
      "aliases": ["restic-backup", "restic-bkp"],
      "description": "Fast, secure, deduplicated backup with restic",
      "example": "rsr restic-backup backup -r /backup/repo /home",
      "category": "backup",
      "subcategory": "tools",
      "path": "scripts/backup/tools/restic-backup.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos", "windows"],
      "requires": ["bash 4.0+", "restic"],
      "sudo": "optional",
      "tags": ["backup", "restic", "deduplication", "encryption", "incremental"]
    },
    {
      "id": "borg-backup",
      "name": "Borg Backup",
      "command": "borg-backup",
      "aliases": ["borg-backup", "borg-bkp"],
      "description": "Deduplicating archiver with compression and encryption",
      "example": "rsr borg-backup create -r /backup/borg -a daily /home",
      "category": "backup",
      "subcategory": "tools",
      "path": "scripts/backup/tools/borg-backup.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos"],
      "requires": ["bash 4.0+", "borg"],
      "sudo": "optional",
      "tags": ["backup", "borg", "borgbackup", "deduplication", "compression", "encryption"]
    },
    {
      "id": "kopia-backup",
      "name": "Kopia Backup",
      "command": "kopia-backup",
      "aliases": ["kopia-backup", "kopia-bkp"],
      "description": "Fast, encrypted, deduplicated backup with Kopia",
      "example": "rsr kopia-backup snapshot /home",
      "category": "backup",
      "subcategory": "tools",
      "path": "scripts/backup/tools/kopia-backup.sh",
      "version": "1.0.0",
      "platforms": ["linux", "macos", "windows"],
      "requires": ["bash 4.0+", "kopia"],
      "sudo": "optional",
      "tags": ["backup", "kopia", "deduplication", "encryption", "snapshot"]
    },
    {
      "id": "timemachine-backup",
      "name": "Time Machine Backup",
      "command": "timemachine",
      "aliases": ["timemachine", "tm-backup"],
      "description": "macOS Time Machine backup management",
      "example": "rsr timemachine status",
      "category": "backup",
      "subcategory": "tools",
      "path": "scripts/backup/tools/timemachine-backup.sh",
      "version": "1.0.0",
      "platforms": ["macos"],
      "requires": ["bash 4.0+", "tmutil"],
      "sudo": "optional",
      "tags": ["backup", "timemachine", "macos", "apple"]
    },
    {
      "id": "windows-backup",
      "name": "Windows Backup",
      "command": "win-backup",
      "aliases": ["win-backup", "windows-backup", "wbadmin-backup"],
      "description": "Windows backup with VSS, File History, and robocopy",
      "example": "rsr win-backup status",
      "category": "backup",
      "subcategory": "tools",
      "path": "scripts/backup/tools/windows-backup.ps1",
      "version": "1.0.0",
      "platforms": ["windows"],
      "requires": ["PowerShell 5.1+"],
      "sudo": "required",
      "tags": ["backup", "windows", "vss", "robocopy", "file-history", "wbadmin"]
    }
  ]
}

