        {
          "short": "-v",
          "long": "--verbose",
          "description": "Enable verbose output"
        }
      ],
      "examples": [
        {
          "command": "rsr users -a",
          "description": "Full user audit"
        },
        {
          "command": "rsr users -s sudo -s passwords",
          "description": "Check sudo and password status"
        },
        {
          "command": "rsr users --sudo-only",
          "description": "List only sudo users"
        },
        {
          "command": "sudo rsr users --orphans",
          "description": "Find orphaned files"
        }
      ],
      "tags": [
        "users",
        "accounts",
        "sudo",
        "security",
        "audit",
        "login",
        "permissions"
      ]
