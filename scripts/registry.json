              "argument": "USER",
              "description": "Username (required)"
            },
            {
              "long": "--remove-home",
              "description": "Remove home directory"
            }
          ]
        },
        {
          "name": "lock",
          "description": "Lock user account"
        },
        {
          "name": "unlock",
          "description": "Unlock user account"
        },
        {
          "name": "list",
          "description": "List user accounts",
          "options": [
            {
              "short": "-a",
              "long": "--all",
              "description": "Show all users including system"
