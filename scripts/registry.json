          ]
        },
        {
          "name": "password",
          "subcommands": [
            {
              "name": "reset",
              "description": "Reset user password"
            },
            {
              "name": "expire",
              "description": "Force password change on next login"
            },
            {
              "name": "generate",
              "description": "Generate random password"
            },
            {
              "name": "policy",
              "description": "Show password policy"
            }
          ]
        },
        {
          "name": "group",
          "subcommands": [
            {
              "name": "create",
              "description": "Create new group"
            },
            {
              "name": "add",
              "description": "Add user to group"
            },
            {
              "name": "remove",
              "description": "Remove user from group"
            },
            {
              "name": "list",
              "description": "List group members"
            },
            {
              "name": "show",
              "description": "Show user's groups"
            }
          ]
        },
        {
          "name": "permission",
          "subcommands": [
            {
              "name": "set",
              "description": "Set file/folder permissions"
            },
            {
              "name": "get",
              "description": "Show current permissions"
            },
            {
              "name": "template",
              "description": "Apply permission template"
            }
          ]
        },
        {
          "name": "ssh",
          "subcommands": [
            {
              "name": "generate",
              "description": "Generate SSH key pair for user"
            },
            {
              "name": "add",
              "description": "Add public key to authorized_keys"
            },
            {
              "name": "remove",
              "description": "Remove key from authorized_keys"
            },
            {
              "name": "list",
              "description": "List authorized SSH keys"
            },
            {
              "name": "copy",
              "description": "Copy SSH keys from another user"
            },
            {
              "name": "validate",
              "description": "Validate authorized_keys file"
            },
            {
              "name": "fix",
              "description": "Fix SSH directory permissions"
            }
          ]
        },
        {
          "name": "session",
          "subcommands": [
            {
              "name": "list",
              "description": "List active sessions"
            },
            {
              "name": "history",
              "description": "Show login history"
            },
            {
              "name": "failures",
              "description": "Show failed logins"
            }
          ]
        },
        {
          "name": "audit",
          "description": "Run comprehensive user audit"
        }
      ],
      "examples": [
        {
          "command": "rsr usermgmt create -u john -c \"John Doe\"",
          "description": "Create user with full name"
        },
        {
          "command": "rsr usermgmt create -u jane -g sudo,docker",
          "description": "Create user with groups"
        },
        {
          "command": "rsr usermgmt delete -u john --remove-home",
          "description": "Delete user and home"
        },
        {
          "command": "rsr usermgmt password reset -u john",
          "description": "Reset password"
        },
        {
          "command": "rsr usermgmt password generate -u jane --set",
          "description": "Generate and set password"
        },
        {
          "command": "rsr usermgmt group add -u john -g docker",
          "description": "Add user to group"
        },
        {
          "command": "rsr usermgmt list --sudo",
          "description": "List sudo users"
        },
        {
          "command": "rsr usermgmt session list",
          "description": "Show active sessions"
        },
        {
          "command": "rsr usermgmt permission set -p /var/www -m 755 -R",
          "description": "Set permissions recursively"
        },
        {
          "command": "rsr usermgmt ssh generate -u john -t ed25519",
          "description": "Generate SSH key"
        },
        {
          "command": "rsr usermgmt ssh add -u john -f ~/.ssh/id_rsa.pub",
          "description": "Add SSH key from file"
        },
        {
          "command": "rsr usermgmt ssh list -u john --fingerprints",
          "description": "List SSH keys with fingerprints"
        },
        {
          "command": "rsr usermgmt group add -u john -g Administrators",
          "description": "Add user to Administrators group (Windows)"
        },
        {
          "command": "powershell .\\rsr.ps1 usermgmt create -u john",
          "description": "Windows: Create user via PowerShell"
        },
        {
          "command": "rsr usermgmt audit",
          "description": "Run user audit"
        }
      ],
      "tags": [
        "users",
        "accounts",
        "passwords",
        "permissions",
        "groups",
        "security",
        "access-control",
        "sudo",
        "management",
        "sessions",
        "ssh",
        "ssh-keys"
