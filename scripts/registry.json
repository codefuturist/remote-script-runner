{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "scripts": [
    {
      "id": "health",
      "name": "system-health-check",
      "displayName": "System Health Check",
      "description": "Check system health: CPU, memory, disk usage, network status",
      "category": "monitoring",
      "version": "1.0.0",
      "author": "codefuturist",
      "shells": {
        "bash": "scripts/bash/system-health-check.sh",
        "zsh": "scripts/zsh/system-health-check.zsh",
        "sh": "scripts/sh/system-health-check.sh",
        "fish": "scripts/fish/system-health-check.fish"
      },
      "defaultShell": "bash",
      "options": [
        {
          "short": "-a",
          "long": "--all",
          "description": "Run all health checks"
        },
        {
          "short": "-v",
          "long": "--verbose",
          "description": "Enable verbose output"
        },
        {
          "short": "-s",
          "long": "--check",
          "argument": "CHECK",
          "description": "Run specific check (cpu, memory, disk, network, services, uptime)"
        }
      ],
      "examples": [
        {
          "command": "rsr health -a",
          "description": "Run all health checks"
        },
        {
          "command": "rsr health -v -s cpu -s memory",
          "description": "Check CPU and memory with verbose output"
        },
        {
          "command": "rsr health -s disk",
          "description": "Check disk usage only"
        }
      ],
      "tags": [
        "cpu",
        "memory",
        "disk",
        "network",
        "monitoring",
        "system",
        "diagnostics"
      ]
    },
    {
