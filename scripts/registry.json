    {
      "id": "cleanup",
      "name": "disk-cleanup",
      "displayName": "Disk Cleanup",
      "description": "Clean temporary files, old logs, package cache, and old kernels",
      "category": "maintenance",
      "version": "1.0.0",
      "author": "codefuturist",
      "shells": {
        "bash": "scripts/bash/disk-cleanup.sh"
      },
      "defaultShell": "bash",
      "options": [
        {
          "short": "-a",
          "long": "--all",
          "description": "Run all cleanup tasks"
        },
        {
          "short": "-d",
          "long": "--dry-run",
          "description": "Show what would be deleted (default)"
        },
        {
          "short": "-x",
          "long": "--execute",
          "description": "Actually perform deletions"
        },
        {
          "short": "-s",
          "long": "--section",
          "argument": "SECTION",
          "description": "Run specific section (tmp, cache, logs, kernels, journal, thumbnails)"
        },
        {
          "short": "-v",
          "long": "--verbose",
          "description": "Verbose output"
        },
        {
          "long": "--older-than",
          "argument": "DAYS",
          "description": "Only remove files older than N days (default: 7)"
        },
        {
          "long": "--keep-kernels",
          "argument": "N",
          "description": "Keep N most recent kernels (default: 2)"
        }
      ],
      "examples": [
        {
          "command": "rsr cleanup -d -a",
          "description": "Dry run all cleanup tasks"
        },
        {
          "command": "rsr cleanup -x -s cache -s logs",
          "description": "Execute cache and log cleanup"
        },
        {
          "command": "sudo rsr cleanup -x -s kernels",
          "description": "Clean old kernels"
        }
      ],
      "tags": [
        "disk",
        "cleanup",
        "temp",
        "logs",
        "cache",
        "kernels",
        "maintenance",
        "storage"
      ]
    },
    {
      "id": "ssl",
      "name": "ssl-checker",
      "displayName": "SSL Certificate Checker",
      "description": "Check SSL certificate expiry, chain validity, and cipher suites",
      "category": "security",
      "version": "1.0.0",
      "author": "codefuturist",
      "shells": {
        "bash": "scripts/bash/ssl-checker.sh"
      },
      "defaultShell": "bash",
      "options": [
        {
          "short": "-d",
          "long": "--domain",
          "argument": "DOMAIN",
          "description": "Check specific domain (can repeat)"
        },
        {
          "short": "-f",
          "long": "--file",
          "argument": "FILE",
          "description": "Read domains from file"
        },
        {
          "short": "-w",
          "long": "--warn",
          "argument": "DAYS",
          "description": "Warning threshold days (default: 30)"
        },
        {
          "short": "-c",
          "long": "--critical",
          "argument": "DAYS",
          "description": "Critical threshold days (default: 7)"
        },
        {
          "short": "-C",
          "long": "--chain",
          "description": "Validate certificate chain"
        },
        {
          "short": "-S",
          "long": "--ciphers",
          "description": "Check for weak cipher suites"
        },
        {
          "short": "-a",
          "long": "--all",
          "description": "Run all checks (chain + ciphers)"
        },
        {
          "short": "-v",
          "long": "--verbose",
          "description": "Show detailed certificate info"
        },
        {
          "short": "-o",
          "long": "--output",
          "argument": "FORMAT",
          "description": "Output format: text, json"
        }
      ],
      "examples": [
        {
          "command": "rsr ssl example.com",
          "description": "Check single domain"
        },
        {
          "command": "rsr ssl -d example.com -d api.example.com",
          "description": "Check multiple domains"
        },
        {
          "command": "rsr ssl -a example.com",
          "description": "Run all checks including chain/ciphers"
        },
        {
          "command": "rsr ssl -f domains.txt -w 60",
          "description": "Check from file, warn at 60 days"
        }
      ],
      "tags": [
        "ssl",
        "tls",
        "certificate",
        "security",
        "expiry",
        "https",
        "cipher"
      ]
    },
