#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Registry sync check - ensure registry.json and rsr are in sync
if git diff --cached --name-only | grep -qE '^(scripts/registry\.json|rsr)$'; then
    echo "🔍 Checking registry.json sync..."
    
    if ! bash tools/build-registry.sh --check; then
        echo ""
        echo "❌ Registry is out of sync!"
        echo ""
        echo "To fix, run:"
        echo "  make build-registry"
        echo ""
        echo "Or to skip this check:"
        echo "  git commit --no-verify"
        exit 1
    fi
    
    echo "✅ Registry is in sync"
fi

# Lint staged shell scripts
echo "🔍 Linting staged shell scripts..."
STAGED_SH_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.sh$' || true)

if [ -n "$STAGED_SH_FILES" ]; then
    for file in $STAGED_SH_FILES; do
        if [ -f "$file" ]; then
            if ! bash -n "$file"; then
                echo "❌ Syntax error in: $file"
                exit 1
            fi
        fi
    done
    echo "✅ All shell scripts have valid syntax"
fi

echo "✅ Pre-commit checks passed"
