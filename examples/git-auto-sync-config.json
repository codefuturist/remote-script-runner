{
  "validation": {
    "enabled": true,
    "max_retries": 3,
    "rollback_on_failure": true
  },
  "quick_check": {
    "enabled": true,
    "interval": 30
  },
  "repositories": [
    {
      "name": "example-repo",
      "path": "/home/user/projects/example-repo",
      "branch": "main",
      "remote": "origin",
      "mode": "safe",
      "use_lfs": false,
      "validator": "",
      "post_hook": ""
    },
    {
      "name": "dns-zones",
      "path": "/etc/bind/zones",
      "branch": "main",
      "remote": "origin",
      "mode": "safe",
      "use_lfs": false,
      "validator": "/usr/local/bin/validate-dns-zones.sh",
      "post_hook": "/usr/local/bin/reload-bind.sh"
    },
    {
      "name": "config-files",
      "path": "/etc/app/config",
      "branch": "production",
      "remote": "origin",
      "mode": "safe",
      "use_lfs": false,
      "validator": "/usr/local/bin/validate-yaml.sh",
      "post_hook": "/usr/local/bin/restart-app.sh"
    }
  ]
}
