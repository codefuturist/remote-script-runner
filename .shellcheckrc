# ShellCheck configuration for remote-script-runner
# https://github.com/koalaman/shellcheck/wiki/Directive

# Default shell for scripts without shebang
shell=bash

# Disable specific warnings project-wide
# SC2034: Unused variable (common in sourced files)
# SC1090: Can't follow non-constant source
# SC1091: Not following sourced file
# SC2155: Declare and assign separately (style preference)
# SC2059: Variables in printf format (intentional for colors)
# SC2248: Prefer double quoting (style preference)
# SC2329: Unused function (may be invoked indirectly)
# SC2086: Double quote to prevent globbing (intentional in some cases)
# SC2249: Consider adding default case (style preference)
# SC2012: Use find instead of ls (acceptable for simple cases)
# SC2181: Check exit code directly (style preference)
# SC2076: Remove quotes from regex (intentional literal match)
# SC2038: Use -print0 with xargs (acceptable for controlled inputs)
# SC2046: Quote to prevent word splitting (intentional in some cases)
# SC2001: Use ${var//search/replace} (sed used for complex patterns)
disable=SC2034,SC1090,SC1091,SC2155,SC2059,SC2248,SC2329,SC2086,SC2249,SC2012,SC2181,SC2076,SC2038,SC2046,SC2001

# Enable optional checks
enable=add-default-case
enable=avoid-nullary-conditions
enable=check-unassigned-uppercase
enable=deprecate-which
enable=quote-safe-variables
