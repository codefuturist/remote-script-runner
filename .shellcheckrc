# ShellCheck configuration for remote-script-runner
# https://github.com/koalaman/shellcheck/wiki/Directive

# Default shell for scripts without shebang
shell=bash

# Disable specific warnings project-wide
# SC2034: Unused variable (common in sourced files)
# SC1090: Can't follow non-constant source
# SC1091: Not following sourced file
disable=SC2034,SC1090,SC1091

# Enable optional checks
enable=add-default-case
enable=avoid-nullary-conditions
enable=check-unassigned-uppercase
enable=deprecate-which
enable=quote-safe-variables
