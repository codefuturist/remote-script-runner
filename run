#!/bin/bash
# DEPRECATED: Use 'rsr' instead. This file will be removed in v2.0.0
# Simple command runner for remote-script-runner
# Usage: ./run [health|setup] [options]
#
# Migration: Replace './run health' with './rsr health'

echo "⚠️  DEPRECATED: 'run' is deprecated. Use 'rsr' instead." >&2
echo "   Example: ./rsr health -a" >&2
echo "" >&2

set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "Usage: $(basename "$0") [health|setup] [options]"
    echo
    echo "Commands:"
    echo "  health [options]  - Run system health checks"
    echo "  setup [options]   - Run server setup"
    echo
    echo "Examples:"
    echo "  $(basename "$0") health -a"
    echo "  $(basename "$0") health -s cpu -s memory"
    echo "  $(basename "$0") setup -d -u admin -p production nginx"
    exit 1
fi

case "$1" in
    health)
        shift
        ./system-health-check.sh "$@"
        ;;
    setup)
        shift
        ./server-setup.sh "$@"
        ;;
    *)
        echo "Error: Unknown command '$1'"
        echo "Use 'health' or 'setup'"
        exit 1
        ;;
esac
