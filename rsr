# ============================================================================
# Main Entry Point
# ============================================================================

main() {
    setup_colors

    # Parse global flags
    while [ $# -gt 0 ]; do
        case "$1" in
            -h | --help | help)
                show_help
                exit 0
                ;;
            -V | --version | version)
                show_version
                exit 0
                ;;
            -v | --verbose)
                RSR_VERBOSE=1
                shift
                ;;
            --shell)
                if [ $# -lt 2 ]; then
                    log_error "--shell requires an argument (bash, zsh, sh)"
                    exit 1
                fi
                RSR_SHELL="$2"
                shift 2
                ;;
            --shell=*)
                RSR_SHELL="${1#--shell=}"
                shift
                ;;
            -*)
                # Unknown flag - pass to subcommand
                break
                ;;
            *)
                # Command found
                break
                ;;
        esac
    done

    # No command after flags - show interactive menu if TTY
    if [ $# -eq 0 ]; then
        if [ -t 0 ] && [ -t 1 ]; then
            # Interactive terminal - show menu
            run_menu
        else
            # Non-interactive (pipe/redirect) - show help
            show_help
        fi
        exit 0
    fi

    COMMAND="$1"
    shift

    case "$COMMAND" in
        menu | interactive)
            run_menu
            ;;
        self-update | upgrade)
            self_update "$@"
            ;;
        health | health-check | system-health-check)
            run_script "health" "$@"
            ;;
        setup | server-setup)
            run_script "setup" "$@"
            ;;
        cleanup | disk-cleanup)
            run_script "cleanup" "$@"
            ;;
        ssl | ssl-checker | ssl-check)
            run_script "ssl" "$@"
            ;;
        users | user-audit)
            run_script "users" "$@"
            ;;
        update | system-update)
            run_script "update" "$@"
            ;;
        audit | security-audit)
            run_script "audit" "$@"
            ;;
        netdiag | network-diagnostics)
            run_script "netdiag" "$@"
            ;;
        ssh-harden | ssh-hardening)
            run_script "ssh-harden" "$@"
            ;;
        firewall | firewall-setup)
            run_script "firewall" "$@"
            ;;
        backup | config-backup)
            run_script "backup" "$@"
            ;;
        db-backup | database-backup)
            run_script "db-backup" "$@"
            ;;
        list | ls)
            list_scripts
            ;;
        *)
            log_error "Unknown command: $COMMAND"
            echo
            printf "Run ${CYAN}rsr list${NC} to see available scripts\n"
            printf "Run ${CYAN}rsr --help${NC} for usage information\n"
            exit 1
            ;;
    esac
}

main "$@"
