                printf "${YELLOW}Note: This script requires sudo access${NC}\n"
                echo
                printf "Run in dry-run mode? (y/N): "
                read -r dryrun
                if [ "$dryrun" = "y" ] || [ "$dryrun" = "Y" ]; then
                    run_script "setup" "-d"
                else
                    run_script "setup"
                fi
                ;;
            3)
                echo
                log_info "Running Firewall Setup..."
                run_script "firewall"
                ;;
            4)
                echo
                printf "${BOLD}Enter domain to check:${NC} "
                read -r domain
                if [ -n "$domain" ]; then
                    log_info "Checking SSL certificate for $domain..."
                    run_script "ssl" "$domain"
                else
                    log_warn "No domain provided"
                fi
                ;;
            5)
                echo
                log_info "Running User Audit..."
                run_script "users"
                ;;
            6)
                echo
                log_info "Running Security Audit..."
                run_script "audit"
                ;;
            7)
                echo
                log_info "Running SSH Hardening..."
                printf "${YELLOW}Note: This will modify SSH configuration${NC}\n"
                printf "Continue? (y/N): "
                read -r confirm
                if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
                    run_script "ssh-harden"
                else
                    log_info "Cancelled"
                fi
                ;;
            8)
                echo
                log_info "Running Disk Cleanup..."
                printf "Run in dry-run mode first? (Y/n): "
                read -r dryrun
                if [ "$dryrun" != "n" ] && [ "$dryrun" != "N" ]; then
                    run_script "cleanup" "--dry-run"
                else
                    run_script "cleanup"
                fi
                ;;
            9)
                echo
                log_info "Running System Update..."
                run_script "update"
                ;;
            10)
                echo
                log_info "Running Configuration Backup..."
                run_script "backup"
                ;;
            11)
                echo
                log_info "Running Database Backup..."
                run_script "db-backup"
                ;;
            12)
                echo
                log_info "Running Network Diagnostics..."
                run_script "netdiag"
                ;;
            h | H)
                show_help
                ;;
            l | L)
                list_scripts
                ;;
            u | U)
                echo
                self_update
                ;;
            q | Q)
                echo
                log_ok "Goodbye!"
                exit 0
                ;;
            "")
                # Empty input, redraw menu
                continue
                ;;
            *)
                echo
                log_error "Invalid choice: $choice"
                ;;
        esac

        # Wait for user to press Enter before continuing
        if [ "$choice" != "q" ] && [ "$choice" != "Q" ] && [ -n "$choice" ]; then
            echo
            printf "${DIM}Press Enter to continue...${NC}"
            read -r _
        fi
    done
}

