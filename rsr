#!/bin/sh
# rsr - Remote Script Runner
# Universal entry point for running scripts locally or remotely
# POSIX-compatible for maximum portability
#
# Usage: curl -fsSL https://codefuturist.github.io/remote-script-runner/rsr | sh -s -- [COMMAND] [OPTIONS]
#        ./rsr [COMMAND] [OPTIONS]
#
# Note: This script is self-contained for remote execution via curl.
#       Shared utilities are available in lib/common.sh for other scripts.

set -eu

# ============================================================================
# Configuration
# ============================================================================

# Try to read version from VERSION file (local), fallback to hardcoded
SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || SCRIPT_DIR=""
if [ -n "$SCRIPT_DIR" ] && [ -f "$SCRIPT_DIR/VERSION" ]; then
    SCRIPT_VERSION=$(cat "$SCRIPT_DIR/VERSION" | tr -d '[:space:]')
else
    SCRIPT_VERSION="1.0.0"
fi

REPO_BASE_URL="https://codefuturist.github.io/remote-script-runner"

# Environment variable defaults
RSR_VERBOSE="${RSR_VERBOSE:-0}"
RSR_TIMEOUT="${RSR_TIMEOUT:-10}"
RSR_SHELL="${RSR_SHELL:-}"

# ============================================================================
# Color Setup
# ============================================================================

setup_colors() {
    if [ -t 1 ]; then
        BLUE='\033[0;34m'
        GREEN='\033[0;32m'
        YELLOW='\033[1;33m'
        RED='\033[0;31m'
        CYAN='\033[0;36m'
        BOLD='\033[1m'
        DIM='\033[2m'
        NC='\033[0m'
    else
        BLUE=''
        GREEN=''
        YELLOW=''
        RED=''
        CYAN=''
        BOLD=''
        DIM=''
        NC=''
    fi
}

# ============================================================================
# Logging Functions
# ============================================================================

log_info() {
    printf "${BLUE}▸${NC} %s\n" "$1"
}

log_ok() {
    printf "${GREEN}✓${NC} %s\n" "$1"
}

log_warn() {
    printf "${YELLOW}⚠${NC} %s\n" "$1" >&2
}

log_error() {
    printf "${RED}✗${NC} %s\n" "$1" >&2
}

log_debug() {
    if [ "$RSR_VERBOSE" = "1" ]; then
        printf "${DIM}[debug]${NC} %s\n" "$1"
    fi
}

# ============================================================================
# Shell Detection & Script Routing
# ============================================================================

detect_shell() {
    if [ -n "$RSR_SHELL" ]; then
        echo "$RSR_SHELL"
        return
    fi
    
    # Prefer bash for widest compatibility
    if command -v bash >/dev/null 2>&1; then
        echo "bash"
    elif command -v zsh >/dev/null 2>&1; then
        echo "zsh"
    elif command -v sh >/dev/null 2>&1; then
        echo "sh"
    else
        log_error "No supported shell found (bash, zsh, or sh)"
        exit 1
    fi
}

# Get shell extension for a given shell type
get_shell_extension() {
    case "$1" in
        bash) echo "sh" ;;
        zsh)  echo "zsh" ;;
        sh)   echo "sh" ;;
        fish) echo "fish" ;;
        *)    echo "sh" ;;
    esac
}

# Dynamic script discovery - finds script by ID
# Searches: scripts/$shell/$name.* and scripts/bash/$name.* as fallback
get_script_path() {
    script_id="$1"
    shell_type="$2"
    
    # Build possible filenames based on script ID
    # Script ID can be: "health" -> matches "system-health-check", "health-check", "health"
    # or full name: "system-health-check" -> matches exactly
    
    ext=$(get_shell_extension "$shell_type")
    
    # If running locally, do filesystem discovery
    if is_local; then
        # First try exact match with shell-specific extension
        for dir in "scripts/$shell_type" "scripts/bash"; do
            [ -d "./$dir" ] || continue
            
            # Try patterns in order of specificity
            for pattern in \
                "$dir/*${script_id}*.$ext" \
                "$dir/*${script_id}*.sh" \
                "$dir/${script_id}.$ext" \
                "$dir/${script_id}.sh"; do
                for file in $pattern; do
                    if [ -f "$file" ]; then
                        echo "$file"
                        return
                    fi
                done
            done
        done
    fi
    
    # Fallback to known mappings (for remote execution without filesystem access)
    # This block is auto-maintained by tools/build-registry.sh
    # --- BEGIN SCRIPT_MAPPINGS ---
    case "$script_id" in
        health|health-check|system-health-check)
            case "$shell_type" in
                bash) echo "scripts/bash/system-health-check.sh" ;;
                zsh)  echo "scripts/zsh/system-health-check.zsh" ;;
                sh)   echo "scripts/sh/system-health-check.sh" ;;
                fish) echo "scripts/fish/system-health-check.fish" ;;
                *)    echo "scripts/bash/system-health-check.sh" ;;
            esac
            ;;
        setup|server-setup)
            case "$shell_type" in
                *) echo "scripts/bash/server-setup.sh" ;;
            esac
            ;;
        *)
            echo ""
            ;;
    esac
    # --- END SCRIPT_MAPPINGS ---
}

# Get script metadata by extracting @description from file header
get_script_description() {
    script_path="$1"
    if [ -f "$script_path" ]; then
        grep -m1 "^# @description" "$script_path" 2>/dev/null | sed 's/^# @description[[:space:]]*//' || echo ""
    fi
}

# Get script display name from @displayName header
get_script_display_name() {
    script_path="$1"
    if [ -f "$script_path" ]; then
        grep -m1 "^# @displayName" "$script_path" 2>/dev/null | sed 's/^# @displayName[[:space:]]*//' || echo ""
    fi
}

# Get script ID from @id header
get_script_id() {
    script_path="$1"
    if [ -f "$script_path" ]; then
        grep -m1 "^# @id" "$script_path" 2>/dev/null | sed 's/^# @id[[:space:]]*//' || echo ""
    fi
}

# ============================================================================
# Execution Helpers
# ============================================================================

is_local() {
    # Check if we're in the repo directory (scripts/bash exists)
    [ -d "./scripts/bash" ] && [ -f "./scripts/bash/system-health-check.sh" ]
}

download() {
    url="$1"
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$url"
    elif command -v wget >/dev/null 2>&1; then
        wget -qO- "$url"
    else
        log_error "Neither curl nor wget is available"
        exit 1
    fi
}

run_script() {
    script_name="$1"
    shift
    
    shell_type=$(detect_shell)
    script_path=$(get_script_path "$script_name" "$shell_type")
    
    if [ -z "$script_path" ]; then
        log_error "Unknown script: $script_name"
        echo "Use 'rsr list' to see available scripts"
        exit 1
    fi
    
    log_debug "Shell: $shell_type"
    log_debug "Script path: $script_path"
    
    if is_local; then
        # Run from scripts directory
        if [ -f "./$script_path" ]; then
            log_debug "Running locally: ./$script_path"
            exec "$shell_type" "./$script_path" "$@"
        fi
        
        # Script not found locally - this shouldn't happen in a proper install
        log_warn "Script not found locally, fetching from remote..."
    fi
    
    # Remote execution
    script_url="$REPO_BASE_URL/$script_path"
    log_debug "Fetching: $script_url"
    
    download "$script_url" | "$shell_type" -s -- "$@"
}

# ============================================================================
# User Interface
# ============================================================================

show_banner() {
    printf "${BOLD}${BLUE}"
    cat << 'EOF'
                    ┌─────────────────────────────┐
                    │   Remote Script Runner      │
                    │          rsr                │
                    └─────────────────────────────┘
EOF
    printf "${NC}"
}

list_scripts() {
    show_banner
    echo
    printf "${BOLD}Available Commands:${NC}\n\n"
    
    # Dynamic listing when running locally
    if is_local && [ -d "./scripts/bash" ]; then
        for script in ./scripts/bash/*.sh; do
            [ -f "$script" ] || continue
            
            script_id=$(get_script_id "$script")
            display_name=$(get_script_display_name "$script")
            description=$(get_script_description "$script")
            
            # Fallback to filename-based ID if no @id header
            if [ -z "$script_id" ]; then
                script_id=$(basename "$script" .sh | sed 's/system-//' | sed 's/-check//')
            fi
            
            printf "  ${GREEN}%-10s${NC} %s\n" "$script_id" "${display_name:-$script_id}"
            if [ -n "$description" ]; then
                printf "            ${DIM}%s${NC}\n" "$description"
            fi
            printf "            ${DIM}rsr %s --help${NC}\n\n" "$script_id"
        done
    else
        # Fallback static list for remote execution
        # This block is auto-maintained by tools/build-registry.sh
        # --- BEGIN SCRIPT_LIST ---
        printf "  ${GREEN}health${NC}    System Health Check\n"
        printf "            Check system health: CPU, memory, disk usage, network status\n"
        printf "            ${DIM}rsr health -a${NC}\n"
        printf "            ${DIM}rsr health -s cpu -s memory -s disk${NC}\n\n"
        
        printf "  ${GREEN}setup${NC}     Server Setup\n"
        printf "            Initial server setup: users, SSH hardening, firewall, common tools\n"
        printf "            ${DIM}rsr setup -d -u admin -p production${NC}\n\n"
        # --- END SCRIPT_LIST ---
    fi
    
    printf "  ${GREEN}list${NC}      Show this list\n\n"
    
    printf "${BOLD}Shell Variants:${NC}\n"
    printf "  ${DIM}scripts/bash/${NC}  Bash       ${DIM}(default)${NC}\n"
    printf "  ${DIM}scripts/zsh/${NC}   Zsh        ${DIM}(macOS default)${NC}\n"
    printf "  ${DIM}scripts/sh/${NC}    POSIX sh   ${DIM}(maximum compatibility)${NC}\n"
    printf "  ${DIM}scripts/fish/${NC}  Fish       ${DIM}(modern interactive)${NC}\n"
}

show_help() {
    show_banner
    cat << EOF

${YELLOW}Usage:${NC}
  rsr <command> [options]
  rsr [flags]

${BOLD}Commands:${NC}
  ${GREEN}run${NC} <script>   Run a script by name or ID
  ${GREEN}list${NC}          List available scripts

${BOLD}Script Shortcuts:${NC}
  ${GREEN}health${NC}        Run system health checks (alias for: run health)
  ${GREEN}setup${NC}         Run server setup (alias for: run setup)

${BOLD}Global Flags:${NC}
  -h, --help       Show this help
  -v, --verbose    Verbose output
  -V, --version    Show version
  --shell SHELL    Force shell (bash, zsh, sh, fish)

${BOLD}Environment Variables:${NC}
  RSR_VERBOSE=1    Enable verbose mode
  RSR_SHELL=bash   Set preferred shell

${BOLD}Examples:${NC}

  ${DIM}# Run all health checks${NC}
  rsr health -a

  ${DIM}# Run by script name${NC}
  rsr run system-health-check -v

  ${DIM}# Specific checks with verbose output${NC}
  rsr health -v -s cpu -s memory

  ${DIM}# Dry-run server setup${NC}
  rsr setup -d -u admin -p production nginx docker

  ${DIM}# Force zsh shell${NC}
  rsr --shell zsh health -a

  ${DIM}# Get help for a specific command${NC}
  rsr health --help

${BOLD}Remote Execution:${NC}

  ${DIM}# Pipe form (recommended)${NC}
  curl -fsSL $REPO_BASE_URL/rsr | sh -s -- health -a

  ${DIM}# bash -c form${NC}
  /bin/sh -c "\$(curl -fsSL $REPO_BASE_URL/rsr)" -- setup -d -u admin

${BOLD}More Info:${NC}
  https://github.com/codefuturist/remote-script-runner

EOF
}

show_version() {
    printf "${BOLD}rsr${NC} version ${GREEN}%s${NC}\n" "$SCRIPT_VERSION"
}

# ============================================================================
# Main Entry Point
# ============================================================================

main() {
    setup_colors
    
    # No arguments - show help
    if [ $# -eq 0 ]; then
        show_help
        exit 0
    fi
    
    # Parse global flags
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help|help)
                show_help
                exit 0
                ;;
            -V|--version|version)
                show_version
                exit 0
                ;;
            -v|--verbose)
                RSR_VERBOSE=1
                shift
                ;;
            --shell)
                if [ $# -lt 2 ]; then
                    log_error "--shell requires an argument (bash, zsh, sh)"
                    exit 1
                fi
                RSR_SHELL="$2"
                shift 2
                ;;
            --shell=*)
                RSR_SHELL="${1#--shell=}"
                shift
                ;;
            -*)
                # Unknown flag - pass to subcommand
                break
                ;;
            *)
                # Command found
                break
                ;;
        esac
    done
    
    # No command after flags
    if [ $# -eq 0 ]; then
        show_help
        exit 0
    fi
    
    COMMAND="$1"
    shift
    
    case "$COMMAND" in
        # Explicit run command
        run)
            if [ $# -eq 0 ]; then
                log_error "run requires a script name"
                echo "Usage: rsr run <script-name> [options]"
                echo "Run 'rsr list' to see available scripts"
                exit 1
            fi
            run_script "$1" "${@:2}"
            ;;
        
        # List command
        list|ls)
            list_scripts
            ;;
        
        # Direct script shortcuts (aliases for common scripts)
        # These are auto-discovered when running locally
        health|health-check|system-health-check)
            run_script "health" "$@"
            ;;
        setup|server-setup)
            run_script "setup" "$@"
            ;;
        
        # Try dynamic lookup for any other command
        *)
            # Check if it's a valid script ID
            shell_type=$(detect_shell)
            script_path=$(get_script_path "$COMMAND" "$shell_type")
            
            if [ -n "$script_path" ]; then
                run_script "$COMMAND" "$@"
            else
                log_error "Unknown command: $COMMAND"
                echo
                printf "Run ${CYAN}rsr list${NC} to see available scripts\n"
                printf "Run ${CYAN}rsr --help${NC} for usage information\n"
                exit 1
            fi
            ;;
    esac
}

main "$@"
