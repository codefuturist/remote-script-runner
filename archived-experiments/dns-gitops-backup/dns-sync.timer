[Unit]
Description=DNS GitOps Sync Timer
Documentation=https://github.com/codefuturist/iac-catalog
Requires=dns-sync.service

[Timer]
# Run every 3 minutes
OnBootSec=2min
OnUnitActiveSec=3min
AccuracySec=30s

# Persistent timer (catch up if system was off)
Persistent=true

[Install]
WantedBy=timers.target
