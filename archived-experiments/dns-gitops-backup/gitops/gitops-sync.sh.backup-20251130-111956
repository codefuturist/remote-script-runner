#!/usr/bin/env bash
# GitOps Auto-Sync Service v2.0
# Improved error handling and resilience

set -uo pipefail

# Configuration  
REPO_URL="${REPO_URL:-https://github.com/codefuturist/iac-catalog.git}"
REPO_BRANCH="${REPO_BRANCH:-develop}"
GITOPS_ROOT="${GITOPS_ROOT:-/opt/gitops}"
REPO_PATH="$GITOPS_ROOT/iac-catalog"
AGE_KEY_FILE="${AGE_KEY_FILE:-$GITOPS_ROOT/.age.key}"
LOCK_FILE="/tmp/gitops-sync.lock"
LOG_FILE="${LOG_FILE:-/var/log/gitops-sync.log}"

MAX_RETRIES=3
RETRY_DELAY=5
LOCK_TIMEOUT=600

EXIT_SUCCESS=0
EXIT_LOCK_FAILED=10
EXIT_PREREQ_FAILED=11
EXIT_REPO_FAILED=12

TOTAL_SECRETS=0
DECRYPTED_SECRETS=0
FAILED_SECRETS=0
RESTARTED_STACKS=0
FAILED_RESTARTS=0

umask 0077

log() {
    local level="${1:-INFO}"
    shift
    echo "[$(date +'%Y-%m-%d %H:%M:%S')][$level] $*" | tee -a "$LOG_FILE"
}

log_info() { log "INFO" "$@"; }
log_warn() { log "WARN" "$@"; }
log_error() { log "ERROR" "$@"; }
log_debug() { log "DEBUG" "$@"; }

acquire_lock() {
    local start_time=$(date +%s)
    
    while true; do
        if [ ! -f "$LOCK_FILE" ]; then
            break
        fi
        
        local pid=$(cat "$LOCK_FILE" 2>/dev/null || echo "")
        
        if [ -z "$pid" ]; then
            log_warn "Empty lock file, removing"
            rm -f "$LOCK_FILE"
            break
        fi
        
        if ! kill -0 "$pid" 2>/dev/null; then
            log_warn "Removing stale lock file (PID $pid)"
            rm -f "$LOCK_FILE"
            break
        fi
        
        local current_time=$(date +%s)
        local elapsed=$((current_time - start_time))
        
        if [ $elapsed -ge $LOCK_TIMEOUT ]; then
            log_error "Lock timeout exceeded ($LOCK_TIMEOUT seconds)"
            return 1
        fi
        
        log_info "Another sync is running (PID: $pid), waiting... ($elapsed/${LOCK_TIMEOUT}s)"
        sleep 5
    done
    
    if ! echo $$ > "$LOCK_FILE" 2>/dev/null; then
        log_error "Failed to create lock file"
        return 1
    fi
    
    log_debug "Lock acquired (PID: $$)"
    return 0
}

release_lock() {
    if [ -f "$LOCK_FILE" ]; then
        local lock_pid=$(cat "$LOCK_FILE" 2>/dev/null || echo "")
        if [ "$lock_pid" = "$$" ]; then
            rm -f "$LOCK_FILE"
            log_debug "Lock released"
        fi
    fi
}

cleanup() {
    local exit_code=$?
    release_lock
    
    if [ $exit_code -eq 0 ]; then
        log_info "=== GitOps Sync Complete ==="
        log_info "Summary: Decrypted $DECRYPTED_SECRETS/$TOTAL_SECRETS secrets, Restarted $RESTARTED_STACKS stacks"
        if [ $FAILED_SECRETS -gt 0 ] || [ $FAILED_RESTARTS -gt 0 ]; then
            log_warn "Warnings: $FAILED_SECRETS failed decryptions, $FAILED_RESTARTS failed restarts"
        fi
    else
        log_error "=== GitOps Sync Failed (exit code: $exit_code) ==="
    fi
    
    exit $exit_code
}

trap cleanup EXIT

check_prerequisites() {
    local missing=()
    
    for cmd in git sops docker; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing+=("$cmd")
        fi
    done
    
    if [ ${#missing[@]} -gt 0 ]; then
        log_error "Missing required tools: ${missing[*]}"
        return 1
    fi
    
    if [ ! -f "$AGE_KEY_FILE" ]; then
        log_error "Age key not found at $AGE_KEY_FILE"
        return 1
    fi
    
    local perms=$(stat -c %a "$AGE_KEY_FILE" 2>/dev/null || stat -f %OLp "$AGE_KEY_FILE" 2>/dev/null)
    if [ "$perms" != "600" ] && [ "$perms" != "400" ]; then
        log_warn "Age key has insecure permissions ($perms), fixing..."
        chmod 600 "$AGE_KEY_FILE"
    fi
    
    log_debug "Prerequisites check passed"
    return 0
}

retry_with_backoff() {
    local max_attempts=$1
    shift
    local attempt=1
    local delay=$RETRY_DELAY
    
    while [ $attempt -le $max_attempts ]; do
        if "$@"; then
            return 0
        fi
        
        if [ $attempt -lt $max_attempts ]; then
            log_warn "Attempt $attempt/$max_attempts failed, retrying in ${delay}s..."
            sleep $delay
            delay=$((delay * 2))
        fi
        
        attempt=$((attempt + 1))
    done
    
    log_error "All $max_attempts attempts failed"
    return 1
}

sync_repo() {
    log_info "Syncing repository from $REPO_URL (branch: $REPO_BRANCH)"
    
    if [ -d "$REPO_PATH/.git" ]; then
        log_info "Updating existing repository..."
        cd "$REPO_PATH"
        
        if ! retry_with_backoff $MAX_RETRIES git fetch origin "$REPO_BRANCH" 2>&1 | tee -a "$LOG_FILE"; then
            log_error "Failed to fetch repository after $MAX_RETRIES attempts"
            return 1
        fi
        
        local local_hash=$(git rev-parse HEAD 2>/dev/null || echo "unknown")
        local remote_hash=$(git rev-parse "origin/$REPO_BRANCH" 2>/dev/null || echo "unknown")
        
        if [ "$local_hash" = "$remote_hash" ]; then
            log_info "Repository is up to date (commit: ${local_hash:0:8})"
            return 2
        fi
        
        log_info "Updates available: ${local_hash:0:8} -> ${remote_hash:0:8}"
        
        git clean -fd 2>&1 | tee -a "$LOG_FILE" || true
        
        if ! git reset --hard "origin/$REPO_BRANCH" 2>&1 | tee -a "$LOG_FILE"; then
            log_error "Failed to reset repository"
            return 1
        fi
        
        log_info "Repository updated successfully to ${remote_hash:0:8}"
    else
        log_info "Cloning repository for the first time..."
        mkdir -p "$GITOPS_ROOT"
        
        if ! retry_with_backoff $MAX_RETRIES git clone --depth 1 --branch "$REPO_BRANCH" "$REPO_URL" "$REPO_PATH" 2>&1 | tee -a "$LOG_FILE"; then
            log_error "Failed to clone repository after $MAX_RETRIES attempts"
            return 1
        fi
        
        log_info "Repository cloned successfully"
    fi
    
    return 0
}

find_encrypted_secrets() {
    find "$REPO_PATH/deployments" -type f -name "*.sops" 2>/dev/null || true
}

decrypt_sops_file() {
    local sops_file="$1"
    local decrypted_file="${sops_file%.sops}"
    
    log_debug "Decrypting: $sops_file"
    
    export SOPS_AGE_KEY_FILE="$AGE_KEY_FILE"
    
    if [[ "$sops_file" == *.env.sops ]]; then
        sops -d --input-type dotenv --output-type dotenv "$sops_file" > "$decrypted_file" 2>>"$LOG_FILE" || return 1
    else
        sops --decrypt "$sops_file" > "$decrypted_file" 2>>"$LOG_FILE" || return 1
    fi
    
    chmod 600 "$decrypted_file"
    log_info "✓ Decrypted: $(basename $sops_file)"
    return 0
}

decrypt_all_secrets() {
    log_info "Searching for encrypted secrets..."
    
    local sops_files=$(find_encrypted_secrets)
    
    if [ -z "$sops_files" ]; then
        log_info "No .sops files found"
        return 0
    fi
    
    TOTAL_SECRETS=$(echo "$sops_files" | wc -l)
    log_info "Found $TOTAL_SECRETS encrypted secret files"
    
    while IFS= read -r sops_file; do
        if decrypt_sops_file "$sops_file"; then
            ((DECRYPTED_SECRETS++)) || true
        else
            ((FAILED_SECRETS++)) || true
            log_warn "Failed to decrypt $sops_file, continuing..."
        fi
    done <<< "$sops_files"
    
    log_info "Decryption summary: $DECRYPTED_SECRETS succeeded, $FAILED_SECRETS failed"
    return 0
}

find_compose_stacks() {
    local changed_dirs=()
    local seen_dirs=()
    
    while IFS= read -r compose_file; do
        local dir=$(dirname "$compose_file")
        
        if [[ " ${seen_dirs[*]} " =~ " ${dir} " ]]; then
            continue
        fi
        
        if [ -f "$dir/.env" ] || [ -n "$(find "$dir/secrets" -type f ! -name "*.sops" ! -name "*.example" ! -name ".gitignore" 2>/dev/null)" ]; then
            changed_dirs+=("$dir")
            seen_dirs+=("$dir")
        fi
    done < <(find "$REPO_PATH/deployments" -type f -name "docker-compose.yml" 2>/dev/null || true)
    
    printf '%s\n' "${changed_dirs[@]}"
}

restart_stack() {
    local stack_dir="$1"
    local stack_name=$(basename "$stack_dir")
    
    log_info "Processing stack: $stack_name"
    
    cd "$stack_dir"
    
    if ! docker compose ps --quiet 2>/dev/null | grep -q .; then
        log_info "Stack $stack_name is not running, skipping"
        return 0
    fi
    
    log_info "Restarting stack: $stack_name"
    
    if timeout 120 docker compose restart 2>&1 | tee -a "$LOG_FILE"; then
        log_info "✓ Restarted: $stack_name"
        return 0
    else
        log_error "Failed to restart stack $stack_name"
        return 1
    fi
}

restart_all_stacks() {
    log_info "Checking for stacks to restart..."
    
    local stacks=$(find_compose_stacks)
    
    if [ -z "$stacks" ]; then
        log_info "No stacks need restarting"
        return 0
    fi
    
    local total_stacks=$(echo "$stacks" | wc -l)
    log_info "Found $total_stacks stacks to process"
    
    while IFS= read -r stack_dir; do
        if restart_stack "$stack_dir"; then
            ((RESTARTED_STACKS++)) || true
        else
            ((FAILED_RESTARTS++)) || true
            log_warn "Failed to restart $(basename $stack_dir), continuing..."
        fi
    done <<< "$stacks"
    
    log_info "Restart summary: $RESTARTED_STACKS succeeded, $FAILED_RESTARTS failed"
    return 0
}

main() {
    log_info "=== GitOps Sync Started ==="
    log_info "Repository: $REPO_URL (branch: $REPO_BRANCH)"
    
    if ! acquire_lock; then
        log_error "Failed to acquire lock"
        exit $EXIT_LOCK_FAILED
    fi
    
    if ! check_prerequisites; then
        log_error "Prerequisites check failed"
        exit $EXIT_PREREQ_FAILED
    fi
    
    sync_repo
    local repo_status=$?
    local repo_updated=true
    
    if [ $repo_status -eq 2 ]; then
        log_info "No repository updates, but will decrypt secrets"
        repo_updated=false
    elif [ $repo_status -ne 0 ]; then
        log_error "Repository sync failed"
        exit $EXIT_REPO_FAILED
    fi
    
    decrypt_all_secrets || log_warn "Some secrets failed to decrypt"
    
    if [ "$repo_updated" = "true" ]; then
        restart_all_stacks || log_warn "Some stacks failed to restart"
    else
        log_info "Skipping stack restarts (no repository changes)"
    fi
    
    exit $EXIT_SUCCESS
}

main "$@"
