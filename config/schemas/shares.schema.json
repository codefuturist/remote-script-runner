{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/codefuturist/remote-script-runner/schemas/shares.schema.json",
  "title": "RSR Network Shares Configuration",
  "description": "Schema for RSR network share configurations",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version",
      "default": "1.0.0"
    },
    "shares": {
      "type": "array",
      "description": "List of saved share configurations",
      "items": {
        "$ref": "#/definitions/share"
      }
    }
  },
  "required": ["shares"],
  "definitions": {
    "share": {
      "type": "object",
      "description": "A network share configuration",
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique identifier for this share configuration",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
          "minLength": 1,
          "maxLength": 64
        },
        "source": {
          "type": "string",
          "description": "Network share path (e.g., //server/share, server:/export)",
          "minLength": 3
        },
        "target": {
          "type": "string",
          "description": "Local mount point (e.g., /mnt/share or Z: on Windows)",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "description": "Share protocol type",
          "enum": ["smb", "cifs", "nfs", "sshfs", "webdav"],
          "default": "smb"
        },
        "options": {
          "type": "string",
          "description": "Mount options (comma-separated)",
          "default": ""
        },
        "automount": {
          "type": "boolean",
          "description": "Whether to automount on boot",
          "default": false
        },
        "automountMethod": {
          "type": "string",
          "description": "Automount method to use",
          "enum": ["fstab", "systemd", "autofs", "launchd", "task-scheduler"],
          "default": "fstab"
        },
        "credentialsStored": {
          "type": "boolean",
          "description": "Whether credentials are stored for this share",
          "default": false
        },
        "description": {
          "type": "string",
          "description": "Optional description of the share"
        },
        "tags": {
          "type": "array",
          "description": "Optional tags for organization",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object",
          "description": "Additional metadata",
          "properties": {
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "lastMounted": {
              "type": "string",
              "format": "date-time"
            },
            "mountCount": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "required": ["name", "source", "target"],
      "additionalProperties": false
    },
    "shareType": {
      "type": "string",
      "description": "Network share protocol",
      "enum": ["smb", "cifs", "nfs", "sshfs", "webdav"]
    },
    "smbOptions": {
      "type": "object",
      "description": "SMB/CIFS specific options",
      "properties": {
        "version": {
          "type": "string",
          "description": "SMB protocol version",
          "enum": ["1.0", "2.0", "2.1", "3.0", "3.1.1", "auto"],
          "default": "auto"
        },
        "domain": {
          "type": "string",
          "description": "Windows domain"
        },
        "iocharset": {
          "type": "string",
          "description": "Character set for filenames",
          "default": "utf8"
        },
        "fileMode": {
          "type": "string",
          "description": "File permission mode",
          "pattern": "^[0-7]{3,4}$",
          "default": "0644"
        },
        "dirMode": {
          "type": "string",
          "description": "Directory permission mode",
          "pattern": "^[0-7]{3,4}$",
          "default": "0755"
        },
        "uid": {
          "type": ["integer", "string"],
          "description": "User ID for mounted files"
        },
        "gid": {
          "type": ["integer", "string"],
          "description": "Group ID for mounted files"
        }
      }
    },
    "nfsOptions": {
      "type": "object",
      "description": "NFS specific options",
      "properties": {
        "version": {
          "type": "string",
          "description": "NFS protocol version",
          "enum": ["3", "4", "4.1", "4.2", "auto"],
          "default": "auto"
        },
        "rsize": {
          "type": "integer",
          "description": "Read buffer size",
          "minimum": 1024
        },
        "wsize": {
          "type": "integer",
          "description": "Write buffer size",
          "minimum": 1024
        },
        "timeo": {
          "type": "integer",
          "description": "Timeout in deciseconds",
          "minimum": 1
        },
        "retrans": {
          "type": "integer",
          "description": "Number of retransmissions",
          "minimum": 0
        },
        "soft": {
          "type": "boolean",
          "description": "Use soft mount (returns errors on timeout)",
          "default": false
        },
        "intr": {
          "type": "boolean",
          "description": "Allow interrupts",
          "default": true
        }
      }
    },
    "sshfsOptions": {
      "type": "object",
      "description": "SSHFS specific options",
      "properties": {
        "port": {
          "type": "integer",
          "description": "SSH port",
          "default": 22,
          "minimum": 1,
          "maximum": 65535
        },
        "identityFile": {
          "type": "string",
          "description": "Path to SSH private key"
        },
        "compression": {
          "type": "boolean",
          "description": "Enable compression",
          "default": false
        },
        "reconnect": {
          "type": "boolean",
          "description": "Reconnect on connection loss",
          "default": true
        },
        "serverAliveInterval": {
          "type": "integer",
          "description": "Keepalive interval in seconds",
          "default": 15
        },
        "serverAliveCountMax": {
          "type": "integer",
          "description": "Maximum keepalive attempts",
          "default": 3
        }
      }
    },
    "webdavOptions": {
      "type": "object",
      "description": "WebDAV specific options",
      "properties": {
        "timeout": {
          "type": "integer",
          "description": "Connection timeout in seconds"
        },
        "trustServerCert": {
          "type": "boolean",
          "description": "Trust self-signed certificates",
          "default": false
        }
      }
    }
  },
  "examples": [
    {
      "shares": [
        {
          "name": "work-files",
          "source": "//fileserver.company.com/shared",
          "target": "/mnt/work",
          "type": "smb",
          "options": "vers=3.0,iocharset=utf8",
          "automount": true,
          "automountMethod": "systemd",
          "description": "Company shared files"
        },
        {
          "name": "home-nas",
          "source": "//192.168.1.100/media",
          "target": "/mnt/nas",
          "type": "smb",
          "automount": false,
          "tags": ["home", "media"]
        },
        {
          "name": "nfs-export",
          "source": "nfs-server:/export/data",
          "target": "/mnt/nfs-data",
          "type": "nfs",
          "options": "rw,soft,timeo=30"
        },
        {
          "name": "remote-dev",
          "source": "user@devserver:/home/user/projects",
          "target": "/mnt/remote-projects",
          "type": "sshfs",
          "options": "reconnect,ServerAliveInterval=15"
        }
      ]
    }
  ]
}

