# kopia.config - Kopia Repository Configuration Template
# Documentation: https://kopia.io/docs/
#
# Usage:
#   kopia repository connect filesystem --path /backup/kopia
#   kopia snapshot create ${HOME}
#   kopia snapshot list
#   kopia restore <snapshot-id> /restore
#
# Kopia uses its own config format stored in:
#   ~/.config/kopia/repository.config
#
# Install: brew install kopia
#          curl -sL https://kopia.io/setup.sh | sudo bash

# =============================================================================
# Repository Connection Examples
# =============================================================================

# Local filesystem:
#   kopia repository create filesystem --path /backup/kopia
#
# SFTP:
#   kopia repository create sftp --path /backup/kopia --host backup-server --username backup --keyfile ~/.ssh/backup_key
#
# Amazon S3:
#   kopia repository create s3 --bucket my-bucket --access-key $AWS_ACCESS_KEY_ID --secret-access-key $AWS_SECRET_ACCESS_KEY
#
# Google Cloud Storage:
#   kopia repository create gcs --bucket my-bucket --credentials-file ~/.config/gcloud/credentials.json
#
# Azure Blob:
#   kopia repository create azure --container my-container --storage-account $AZURE_ACCOUNT --storage-key $AZURE_KEY
#
# Backblaze B2:
#   kopia repository create b2 --bucket my-bucket --key-id $B2_KEY_ID --key $B2_KEY

# =============================================================================
# Policy Configuration (via CLI)
# =============================================================================

# Set global policy:
#   kopia policy set --global \
#     --keep-latest 10 \
#     --keep-hourly 24 \
#     --keep-daily 7 \
#     --keep-weekly 4 \
#     --keep-monthly 12 \
#     --keep-annual 3 \
#     --compression zstd-fastest

# Set policy for specific path:
#   kopia policy set ${HOME} \
#     --add-ignore ".cache" \
#     --add-ignore "node_modules" \
#     --add-ignore ".venv" \
#     --add-ignore "__pycache__" \
#     --add-ignore ".DS_Store"

# =============================================================================
# Snapshot Examples
# =============================================================================

# Create snapshot:
#   kopia snapshot create ${HOME}
#   kopia snapshot create ${HOME}/Documents ${HOME}/Pictures
#   kopia snapshot create /etc /var/www --tags server,config

# List snapshots:
#   kopia snapshot list
#   kopia snapshot list --all
#   kopia snapshot list ${HOME}

# Restore:
#   kopia restore <snapshot-id> /restore
#   kopia restore <snapshot-id> /restore --snapshot-time 2024-01-01T00:00:00Z
#   kopia mount all /mnt/kopia

# =============================================================================
# Scheduling with Kopia Server
# =============================================================================

# Kopia has built-in server mode with scheduling:
#
# Start server:
#   kopia server start --insecure --address 0.0.0.0:51515
#
# Or as systemd service:
#   sudo kopia server start --insecure --address 0.0.0.0:51515 &
#
# The server provides:
#   - Web UI at http://localhost:51515
#   - Automatic scheduling
#   - Multiple repository support
#   - User management

# =============================================================================
# Systemd Service Example
# =============================================================================

# /etc/systemd/system/kopia-backup.service
# [Unit]
# Description=Kopia Backup
# After=network-online.target
#
# [Service]
# Type=oneshot
# User=root
# ExecStart=/usr/bin/kopia snapshot create /home /etc
#
# [Install]
# WantedBy=multi-user.target

# /etc/systemd/system/kopia-backup.timer
# [Unit]
# Description=Daily Kopia Backup
#
# [Timer]
# OnCalendar=*-*-* 02:00:00
# Persistent=true
#
# [Install]
# WantedBy=timers.target

# =============================================================================
# Quick Start Script
# =============================================================================

